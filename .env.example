# Kopieer dit bestand naar .env en vul in wat je hebt.
# .env staat in .gitignore en komt dus nooit in GitHub terecht.

# --- Claude schrijft de scripts ---
# Sleutel maken op https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- ElevenLabs spreekt de video in ---
# Sleutel maken op https://elevenlabs.io  (Profile -> API Keys)
ELEVENLABS_API_KEY=

# --- YouTube publiceert ---
# Deze drie haal je in een keer op met: python scripts/get_youtube_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
