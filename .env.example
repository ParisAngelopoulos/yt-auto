# Kopieer dit bestand naar .env en vul in wat je hebt.
# .env staat in .gitignore en komt dus nooit in GitHub terecht.
#
# Alle drie de sleutels hieronder zijn OPTIONEEL. Zonder sleutels schrijft de
# ingebouwde verteller het script en spreekt Piper het in; dat kost niets en
# levert een video op die je kunt publiceren. De YouTube-regels heb je alleen
# nodig als de studio zelf moet uploaden.

# --- Claude schrijft de scripts (optioneel, ongeveer 15 cent per script) ---
# Zonder deze sleutel schrijft de ingebouwde verteller het verhaal.
# Sleutel maken op https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- ElevenLabs spreekt de video in (optioneel, betaald) ---
# Zonder deze sleutel spreekt Piper de video in: gratis en lokaal.
# Sleutel maken op https://elevenlabs.io  (Profile -> API Keys)
ELEVENLABS_API_KEY=

# --- YouTube publiceert (gratis, maar wel eenmalig instellen) ---
# Deze drie haal je in een keer op met: python scripts/get_youtube_token.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
